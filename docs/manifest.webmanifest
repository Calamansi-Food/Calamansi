{
  "id": "./",
  "name": "Calamansi",
  "short_name": "Calamansi",
  "description": "Home, kitchen and daily life around your shifts: chores, recipes with air-fryer and oven times, a meal planner for 12-hour days and nights, the fridge, the shopping list, bills and the car. The home app of the citrus family.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
